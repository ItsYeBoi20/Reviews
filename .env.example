# ---------------------------------------------------------------------------
# Verdict: copy to .env and fill in. Everything defaults to offline mode
# (fixture Reddit data + mock analyzer) so the app runs with zero API keys.
# ---------------------------------------------------------------------------

# Database (also hosts the pg-boss job queue)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/verdict

# API server
API_PORT=4000
COOKIE_SECURE=false
# Origins allowed to send POST/PUT/DELETE (CSRF guard), comma-separated
ALLOWED_ORIGINS=http://localhost:3000

# Web (server-side calls go straight to the API; browser calls go through /api rewrites)
API_INTERNAL_URL=http://localhost:4000

# Reddit source: fixtures | api
REDDIT_SOURCE=fixtures
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit rejects generic user agents. Format: <platform>:<app id>:<version> (by /u/<username>)
REDDIT_USER_AGENT=web:verdict:0.1.0 (by /u/CHANGE_ME)
# Raw comment text is nulled after this many days
REDDIT_RETENTION_DAYS=30

# AI provider for consensus analysis: mock | mittwald | mindstudio | openai-compatible | anthropic
# mock runs offline. For real data use mittwald (set LLM_PROVIDER=mittwald and the key below).
LLM_PROVIDER=mock

# mittwald AI Hosting: create the API key in mStudio (AI Hosting section)
MITTWALD_API_KEY=
# gpt-oss-120b (default) | Ministral-3-14B-Instruct-2512 | Qwen3.6-35B-A3B-FP8 ... see GET /v1/models
MITTWALD_MODEL=gpt-oss-120b
MITTWALD_BASE_URL=https://llm.aihosting.mittwald.de/v1

# Shared by mittwald and openai-compatible:
# json_schema (default; falls back automatically if rejected) | json_object | prompt
LLM_JSON_MODE=
# low | medium | high, only for reasoning models such as gpt-oss. Leave empty to use the server default.
LLM_REASONING_EFFORT=
# Comments per labeling call / parallel calls. Lower if the provider rate-limits you.
LLM_BATCH_SIZE=40
LLM_CONCURRENCY=3

# mindstudio: run a MindStudio agent you built (see docs/PLAN.md, "AI provider")
MINDSTUDIO_API_KEY=
MINDSTUDIO_APP_ID=
MINDSTUDIO_WORKFLOW=
MINDSTUDIO_RUN_URL=https://api.mindstudio.ai/developer/v2/apps/run

# openai-compatible: LM Studio (http://localhost:1234/v1), Mistral, OpenRouter, vLLM, Ollama...
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high: labeling comments rarely benefits from more
ANTHROPIC_EFFORT=low

# Worker
CONSENSUS_CONCURRENCY=2
CONSENSUS_TICK_BATCH=25
# 1 = seed uses LLM_PROVIDER instead of the mock analyzer (spends credits)
SEED_WITH_LLM=0

# Catalog import (optional; seed data works without these)
TMDB_API_TOKEN=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
